# Secrets et environnement local
.env

# Base SQLite, journaux WAL et fichiers de travail : jamais versionnés. Ils contiennent
# le contenu des dossiers, et un dépôt n'est pas le bon endroit pour ça.
var/

# Environnement virtuel : recréé par run.sh, dépendant de chemins absolus.
.venv/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Systèmes de fichiers
.DS_Store

# Classeurs, où qu'ils soient. La règle valait pour la racine seule, et un dossier de
# fichiers publiés déposé dans l'arbre de travail — douze mois de flash, par exemple —
# passait au travers : un `git add -A` distrait aurait suffi à publier des chiffres et des
# noms réels. Le budget et l'annuaire vivent dans var/ ; tout le reste est un fichier de
# travail, et aucun n'a sa place ici.
*.xlsx
*.xlsm
*.csv

# Sauf les exemples, qui ne sont qu'une forme : des colonnes, aucune valeur de la maison.
!docs/*.example.csv
