# CEO OS — Decision Room · configuration locale
# Copier en `.env`. Aucune de ces variables ne peut ouvrir le produit sur l'extérieur :
# les garde-fous qui comptent sont dans le code, pas ici (voir app/config.py).

# local | pilot — « local » seul autorise `seed --reset`, qui efface tout.
CEOOS_ENV=local

# READ | PREPARE. EXECUTE n'existe pas : il est refusé par le code, et le service
# refuse alors de démarrer. Le produit ne peut ni envoyer, ni modifier, ni engager.
CEOOS_AUTONOMY_LEVEL=PREPARE

# Signature du cookie de session. Obligatoire hors local, 32 caractères minimum.
# En local, un secret jetable est tiré à chaque démarrage si la variable est vide.
CEOOS_SECRET_KEY=

# SQLite pour le prototype, PostgreSQL en cible. Un chemin relatif est résolu depuis la
# racine du projet, jamais depuis le répertoire de travail.
CEOOS_DATABASE_URL=sqlite:///var/ceo-os.db

# Port d'écoute. L'ADRESSE, elle, n'est pas configurable : 127.0.0.1 est une constante
# de app/cli.py. Un --host 0.0.0.0 collé par erreur reste sans effet.
PORT=8000

# --- Source des chiffres de performance ---
# mock (défaut) | snowflake. L'entrepôt ne se joint jamais par accident : il faut le
# demander ici ET nommer une connexion ci-dessous.
CEOOS_DATA_SOURCE=mock

# Nom d'une connexion de ~/.snowflake/connections.toml — le fichier que la CLI Snowflake
# et Cortex Code utilisent déjà. Aucun identifiant n'est lu ni stocké par l'application,
# et aucun n'a sa place dans ce dépôt. Le nom est entre crochets dans ce fichier :
#     grep '^\[' ~/.snowflake/connections.toml
CEOOS_SNOWFLAKE_CONNECTION=

# --- Fichiers locaux ---
# Ce que l'entrepôt ne sait pas : le plan, qui possède quel marché, et ce que les chiffres
# ne peuvent pas dire. Tous vivent dans var/, que git ignore. Les chemins par défaut
# conviennent presque toujours ; ces trois lignes existent pour dire où regarder.
#     var/budget.xlsx     le classeur de planification
#     var/owners.xlsx     l'annuaire des patrons de BU et GM pays
#     var/context.csv     les notes, écrites par `manage.py note`
#
# `manage.py check` dit lesquels sont en place.
